# Copy to .env and fill in locally. NEVER commit .env.
# This file lists variable NAMES only - no values, no secrets.

# ---- Platform ----
# Which config/environments/<APP_ENV>.json to load. dev | staging | prod
APP_ENV=

# Browser visibility. Leave empty for the safe default (headless=true).
# Set to false ONLY on a developer machine with a display.
HEADLESS=

# trace | debug | info | warn | error | fatal
LOG_LEVEL=

# true = human-readable logs via pino-pretty (developer machines only).
# Production must stay false so logs are JSON for the log pipeline.
LOG_PRETTY=

# true = launch Chromium with --no-sandbox. Only needed when running as root in
# a container. Prefer the non-root `pwuser` in the provided image instead.
CHROMIUM_NO_SANDBOX=

# ---- Which queue backend to use ----
# Overrides config/environments/<APP_ENV>.json. local | orchestrator
QUEUE_PROVIDER=
# robot | odata. robot is the REFramework path and needs a robot identity.
QUEUE_MODE=

# ---- UiPath Orchestrator ----
# Created as an External Application in Orchestrator, with these scopes:
#   OR.Queues          consume and dispatch queue items
#   OR.Assets          read assets
#   OR.Administration  required to WRITE to storage buckets
# The client secret is shown once at creation. Store it in your secrets manager,
# not here, on any shared machine.
ORCH_CLIENT_ID=
ORCH_CLIENT_SECRET=

# Unattended robot key. Required for queue.mode "robot", and the only way to
# read a Credential asset's password - see the README.
ORCH_ROBOT_KEY=

# ---- Orchestrator smoke test (optional, opt-in) ----
# Set ORCH_SMOKE=1 to run the sandbox round-trip test in `pnpm test`.
# Without it the smoke test skips and the rest of the suite is unaffected.
ORCH_SMOKE=
ORCH_BASE_URL=
ORCH_ORGANIZATION=
ORCH_TENANT=
ORCH_FOLDER_ID=
ORCH_QUEUE_NAME=
# Optional: exercises storage buckets. Needs OR.Administration.
ORCH_BUCKET_NAME=
# Optional: space-separated scope override for the smoke test.
ORCH_SCOPES=

# ---- Carrier portal credentials (PoC phase 1) ----
# Both portals also require MFA; the code is read from a Gmail label.
# See docs/poc/mfa-gmail.md.
ANTHEM_PORTAL_USERNAME=
ANTHEM_PORTAL_PASSWORD=

# ── MFA over IMAP (mfa.provider = "imap") ────────────────────────────────────
# An INTERIM option that unblocks the PoCs: no browser, so it works headless and
# on Linux, unlike the gmail-profile/gmail-cdp providers. The trade-off is that
# an IMAP credential reaches the WHOLE mailbox rather than one label, which is
# why docs/poc/mfa-gmail.md still points at gmail-api as the destination.
#
# MFA_IMAP_APP_PASSWORD must be a Google APP PASSWORD, not the mailbox password
# - Google stopped accepting those for IMAP. App passwords need 2-Step
# Verification on the account, and a Workspace admin can disable them.
# For XOAUTH2, setting this variable is NOT enough on its own: config decides
# WHICH variable is read, so the environment layer must also name it -
#   "mfa": { "imap": { "accessTokenEnv": "MFA_IMAP_ACCESS_TOKEN" } }
# in config/environments/<env>.json. Setting both there is allowed and the TOKEN
# wins, which is the only way a layer can select OAuth: the code default always
# supplies passwordEnv and the loader cannot un-set a default key.
MFA_IMAP_USER=
MFA_IMAP_APP_PASSWORD=
# MFA_IMAP_ACCESS_TOKEN=

# Producer identity for the Anthem CA submission. A real licensed producer and a
# real agency code (which doubles as that agency's encrypted TIN), so these live
# here and never in config - see docs/poc/sanitization.md. Config carries only
# the variable NAMES. Get the values from the Benefits runbook.
ANTHEM_PRODUCER_FIRST_NAME=
ANTHEM_PRODUCER_LAST_NAME=
ANTHEM_PAID_AGENCY_CODE=
UHC_PORTAL_USERNAME=
UHC_PORTAL_PASSWORD=

# ---- MFA via Gmail ----
# Phase 1 uses a DEDICATED Chromium profile that a human signed into once, so
# no Gmail credential is needed here at all. It cannot be your everyday Chrome
# profile: Chrome 136+ refuses to expose a debugging interface for the default
# profile, and a copied profile arrives signed out because macOS encrypts its
# cookies against a Keychain entry Chromium cannot read.
# Phase 2 uses the Gmail API: one interactive OAuth consent, then a refresh
# token that works headless. Gmail's basic HTML view was retired in January
# 2024, so the API is the only option that does not depend on Gmail's markup.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Which mailbox to sign into when seeding the profile. Not a secret, and not
# read at runtime - it only pins `rpa mfa seed-profile` to the right account so
# a profile cannot end up silently reading the wrong inbox.
GMAIL_ACCOUNT=
# Fallback label for `rpa mfa check` only. At RUNTIME the label comes from each
# automation's own config.<env>.json, because the two carriers use different
# labels: "Access Token (Anthem)" and "Access Token (UnitedHealthcare)". The
# automation reads ONLY its label - never the inbox, never the wider mailbox.
GMAIL_MFA_LABEL=

# ---- Automation credentials (names resolved via ctx.secrets) ----
# group-submission/carrier-portal-submission-demo -> saucedemo.com
# These are PUBLIC demo credentials, but they are still read from the
# environment so the code path matches a real portal credential.
SAUCE_USERNAME=
SAUCE_PASSWORD=
