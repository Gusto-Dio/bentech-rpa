{
  "name": "bentech-rpa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RPA platform monorepo: REFramework semantics on Playwright + TypeScript",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "rpa": "tsx packages/cli/src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "pnpm rpa validate",
    "verify:templates": "tsx tooling/scripts/verify-templates.ts",
    "check": "pnpm typecheck && pnpm validate && pnpm test",
    "browsers:install": "playwright install chromium",
    "browsers:install:linux": "playwright install --with-deps chromium",
    "mcp": "playwright-mcp --config playwright-mcp.config.json",
    "test": "node --import tsx --test \"packages/**/*.test.ts\" \"automations/**/*.test.ts\" \"tooling/**/*.test.ts\"",
    "heal:selftest": "tsx tooling/healing/probe-self-test.ts"
  },
  "devDependencies": {
    "@auto/group-submission-shared": "workspace:*",
    "@playwright/mcp": "0.0.80",
    "@rpa/core": "workspace:*",
    "@types/node": "24.13.3",
    "pino-pretty": "13.1.3",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "tsx": "4.23.13"
  }
}
