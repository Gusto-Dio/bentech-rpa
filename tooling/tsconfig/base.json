{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    // Node ESM. Relative imports carry an explicit .js extension so that this
    // code would still run unchanged if the platform later adds a compile step.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // macOS is case-insensitive, Ubuntu is not. Without this, a mis-cased
    // import compiles on a developer laptop and fails on the server.
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    // Workspace packages resolve straight to their TypeScript sources
    // (see each package's "exports"). tsx runs those directly, so there is no
    // build step and therefore nothing to emit.
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
